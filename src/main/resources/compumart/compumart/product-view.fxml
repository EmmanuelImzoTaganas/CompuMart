<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="root"
            stylesheets="@cssfiles/main.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"


    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-bar">
                <padding>
                    <Insets top="10.0" right="30.0" bottom="10.0" left="30.0"/>
                </padding>
                <children>
                    <Label styleClass="store-title" text="COMPUMART ADMIN"/>
                    <HBox HBox.hgrow="ALWAYS"/> <Button mnemonicParsing="false" styleClass="nav-button" text="Dashboard"/>
                    <Button mnemonicParsing="false" styleClass="nav-button-selected" text="Products"/>
                    <Button mnemonicParsing="false" styleClass="nav-button" text="Users"/>
                    <Button mnemonicParsing="false" styleClass="nav-button" text="Orders"/>
                    <Button fx:id="logoutButton" mnemonicParsing="false" styleClass="nav-button" text="Logout"/>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="filter-bar">
                <padding>
                    <Insets top="15.0" right="30.0" bottom="15.0" left="30.0"/>
                </padding>
                <children>
                    <Label styleClass="filter-bar-title" text="Product Management"/>
                    <Region HBox.hgrow="ALWAYS"/> <Button onAction="#backAdmin" text="Back to Dashboard"
                                                          styleClass="cart-button" mnemonicParsing="false"/>
                </children>
            </HBox>

        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f4f4f4;">
            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>
            <content>
                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                        <Tab text="Keyboard">
                            <content>
                                <BorderPane style="-fx-background-color: #fcf6e8; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                                    <center>
                                        <TableView fx:id="tableView">
                                            <columns>
                                                <TableColumn fx:id="stockColumn" prefWidth="135.0" text="Stock" />
                                                <TableColumn fx:id="brandColumn" prefWidth="145.0" text="Product Brand" />
                                                <TableColumn fx:id="modelColumn" prefWidth="230.0" text="Product Model" />
                                                <TableColumn fx:id="priceColumn" prefWidth="90.0" text="Price(PHP)" />
                                                <TableColumn fx:id="imageColumn" prefWidth="180.0" text="Image Name" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </center>
                                    <bottom>
                                        <HBox styleClass="action-bar" spacing="10">
                                            <padding>
                                                <Insets top="15.0"/>
                                            </padding>
                                            <TextField fx:id="stockField" prefWidth="60.0" promptText="Stock" />
                                            <TextField fx:id="brandField" prefWidth="100.0" promptText="Brand" />
                                            <TextField fx:id="modelField" prefWidth="150.0" promptText="Model" />
                                            <TextField fx:id="priceField" prefWidth="80.0" promptText="Price" />
                                            <TextField fx:id="imageField" prefWidth="150.0" promptText="Image Name" />
                                            <HBox HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleAddProduct" text="Add" styleClass="admin-button" />
                                            <Button onAction="#handleEditProduct" text="Edit" styleClass="edit-button" />
                                            <Button onAction="#handleDeleteProduct" text="Delete" styleClass="delete-button" />
                                        </HBox>
                                    </bottom>
                                </BorderPane>
                            </content>
                        </Tab>

                        <Tab text="Mouse">
                            <content>
                                <BorderPane style="-fx-background-color: #fcf6e8; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                                    <center>
                                        <TableView fx:id="tableView1">
                                            <columns>
                                                <TableColumn fx:id="stockColumn1" prefWidth="135.0" text="Stock" />
                                                <TableColumn fx:id="brandColumn1" prefWidth="145.0" text="Product Brand" />
                                                <TableColumn fx:id="modelColumn1" prefWidth="230.0" text="Product Model" />
                                                <TableColumn fx:id="priceColumn1" prefWidth="90.0" text="Price(PHP)" />
                                                <TableColumn fx:id="imageColumn1" prefWidth="180.0" text="Image Name" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </center>
                                    <bottom>
                                        <HBox styleClass="action-bar" spacing="10">
                                            <padding>
                                                <Insets top="15.0"/>
                                            </padding>
                                            <TextField fx:id="stockField1" prefWidth="60.0" promptText="Stock" />
                                            <TextField fx:id="brandField1" prefWidth="100.0" promptText="Brand" />
                                            <TextField fx:id="modelField1" prefWidth="150.0" promptText="Model" />
                                            <TextField fx:id="priceField1" prefWidth="80.0" promptText="Price" />
                                            <TextField fx:id="imageField1" prefWidth="150.0" promptText="Image Name" />
                                            <HBox HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleAddProduct" text="Add" styleClass="admin-button" />
                                            <Button onAction="#handleEditProduct" text="Edit" styleClass="edit-button" />
                                            <Button onAction="#handleDeleteProduct" text="Delete" styleClass="delete-button" />
                                        </HBox>
                                    </bottom>
                                </BorderPane>
                            </content>
                        </Tab>

                        <Tab text="Storage">
                            <content>
                                <BorderPane style="-fx-background-color: #fcf6e8; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                                    <center>
                                        <TableView fx:id="tableView21">
                                            <columns>
                                                <TableColumn fx:id="stockColumn21" prefWidth="135.0" text="Stock" />
                                                <TableColumn fx:id="brandColumn21" prefWidth="145.0" text="Product Brand" />
                                                <TableColumn fx:id="modelColumn21" prefWidth="230.0" text="Product Model" />
                                                <TableColumn fx:id="priceColumn21" prefWidth="90.0" text="Price(PHP)" />
                                                <TableColumn fx:id="imageColumn21" prefWidth="180.0" text="Image Name" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </center>
                                    <bottom>
                                        <HBox styleClass="action-bar" spacing="10">
                                            <padding>
                                                <Insets top="15.0"/>
                                            </padding>
                                            <TextField fx:id="stockField2" prefWidth="60.0" promptText="Stock" />
                                            <TextField fx:id="brandField2" prefWidth="100.0" promptText="Brand" />
                                            <TextField fx:id="modelField2" prefWidth="150.0" promptText="Model" />
                                            <TextField fx:id="priceField2" prefWidth="80.0" promptText="Price" />
                                            <TextField fx:id="imageField2" prefWidth="150.0" promptText="Image Name" />
                                            <HBox HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleAddProduct" text="Add" styleClass="admin-button" />
                                            <Button onAction="#handleEditProduct" text="Edit" styleClass="edit-button" />
                                            <Button onAction="#handleDeleteProduct" text="Delete" styleClass="delete-button" />
                                        </HBox>
                                    </bottom>
                                </BorderPane>
                            </content>
                        </Tab>

                        <Tab text="Memory">
                            <content>
                                <BorderPane style="-fx-background-color: #fcf6e8; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                                    <center>
                                        <TableView fx:id="tableView211">
                                            <columns>
                                                <TableColumn fx:id="stockColumn211" prefWidth="135.0" text="Stock" />
                                                <TableColumn fx:id="brandColumn211" prefWidth="145.0" text="Product Brand" />
                                                <TableColumn fx:id="modelColumn211" prefWidth="230.0" text="Product Model" />
                                                <TableColumn fx:id="priceColumn211" prefWidth="90.0" text="Price(PHP)" />
                                                <TableColumn fx:id="imageColumn211" prefWidth="180.0" text="Image Name" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </center>
                                    <bottom>
                                        <HBox styleClass="action-bar" spacing="10">
                                            <padding>
                                                <Insets top="15.0"/>
                                            </padding>
                                            <TextField fx:id="stockField211" prefWidth="60.0" promptText="Stock" />
                                            <TextField fx:id="brandField211" prefWidth="100.0" promptText="Brand" />
                                            <TextField fx:id="modelField211" prefWidth="150.0" promptText="Model" />
                                            <TextField fx:id="priceField211" prefWidth="80.0" promptText="Price" />
                                            <TextField fx:id="imageField211" prefWidth="150.0" promptText="Image Name" />
                                            <HBox HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleAddProduct" text="Add" styleClass="admin-button" />
                                            <Button onAction="#handleEditProduct" text="Edit" styleClass="edit-button" />
                                            <Button onAction="#handleDeleteProduct" text="Delete" styleClass="delete-button" />
                                        </HBox>
                                    </bottom>
                                </BorderPane>
                            </content>
                        </Tab>

                        <Tab text="Monitor">
                            <content>
                                <BorderPane style="-fx-background-color: #fcf6e8; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                                    <center>
                                        <TableView fx:id="tableView2111">
                                            <columns>
                                                <TableColumn fx:id="stockColumn2111" prefWidth="135.0" text="Stock" />
                                                <TableColumn fx:id="brandColumn2111" prefWidth="145.0" text="Product Brand" />
                                                <TableColumn fx:id="modelColumn2111" prefWidth="230.0" text="Product Model" />
                                                <TableColumn fx:id="priceColumn2111" prefWidth="90.0" text="Price(PHP)" />
                                                <TableColumn fx:id="imageColumn2111" prefWidth="180.0" text="Image Name" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </center>
                                    <bottom>
                                        <HBox styleClass="action-bar" spacing="10">
                                            <padding>
                                                <Insets top="15.0"/>
                                            </padding>
                                            <TextField fx:id="stockField2111" prefWidth="60.0" promptText="Stock" />
                                            <TextField fx:id="brandField2111" prefWidth="100.0" promptText="Brand" />
                                            <TextField fx:id="modelField2111" prefWidth="150.0" promptText="Model" />
                                            <TextField fx:id="priceField2111" prefWidth="80.0" promptText="Price" />
                                            <TextField fx:id="imageField2111" prefWidth="150.0" promptText="Image Name" />
                                            <HBox HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleAddProduct" text="Add" styleClass="admin-button" />
                                            <Button onAction="#handleEditProduct" text="Edit" styleClass="edit-button" />
                                            <Button onAction="#handleDeleteProduct" text="Delete" styleClass="delete-button" />
                                        </HBox>
                                    </bottom>
                                </BorderPane>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>