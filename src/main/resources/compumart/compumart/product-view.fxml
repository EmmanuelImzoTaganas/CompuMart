<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="1000.0"
            styleClass="root"
            stylesheets="@cssfiles/main.css"
            fx:controller="compumart.compumart.controller.ProductController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- Top Navigation -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-bar">
                <padding>
                    <Insets top="10" right="30" bottom="10" left="30"/>
                </padding>
                <children>
                    <Label styleClass="store-title" text="COMPUMART ADMIN"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button text="Dashboard" styleClass="nav-button"/>
                    <Button text="Products" styleClass="nav-button-selected"/>
                    <Button text="Users" styleClass="nav-button"/>
                    <Button text="Orders" styleClass="nav-button"/>
                    <Button fx:id="logoutButton" text="Logout" styleClass="nav-button"/>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="filter-bar">
                <padding>
                    <Insets top="15" right="30" bottom="15" left="30"/>
                </padding>
                <children>
                    <Label styleClass="filter-bar-title" text="Product Management"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#toDashboard" text="Back to Dashboard" styleClass="cart-button"/>
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- Center TabPane -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f4f4f4;">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>
            <content>
                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">

                    <!-- Keyboard Tab -->
                    <Tab text="Keyboard">
                        <content>
                            <VBox spacing="10">
                                <TableView fx:id="tableKeyboard" prefHeight="200">
                                    <columns>
                                        <TableColumn fx:id="stockKeyboardColumn" text="Stock"/>
                                        <TableColumn fx:id="brandKeyboardColumn" text="Brand"/>
                                        <TableColumn fx:id="modelKeyboardColumn" text="Model"/>
                                        <TableColumn fx:id="priceKeyboardColumn" text="Price(PHP)"/>
                                        <TableColumn fx:id="imageKeyboardColumn" text="Image"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="stockKeyboard" promptText="Stock" prefWidth="60"/>
                                    <TextField fx:id="brandKeyboard" promptText="Brand" prefWidth="100"/>
                                    <TextField fx:id="modelKeyboard" promptText="Model" prefWidth="150"/>
                                    <TextField fx:id="priceKeyboard" promptText="Price" prefWidth="80"/>
                                    <TextField fx:id="imageKeyboard" promptText="Image" prefWidth="150"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="addKeyboard" text="Add" onAction="#addProduct"/>
                                    <Button fx:id="editKeyboard" text="Edit" onAction="#editProduct"/>
                                    <Button fx:id="deleteKeyboard" text="Delete" onAction="#deleteProduct"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- Mouse Tab -->
                    <Tab text="Mouse">
                        <content>
                            <VBox spacing="10">
                                <TableView fx:id="tableMouse" prefHeight="200">
                                    <columns>
                                        <TableColumn fx:id="stockMouseColumn" text="Stock"/>
                                        <TableColumn fx:id="brandMouseColumn" text="Brand"/>
                                        <TableColumn fx:id="modelMouseColumn" text="Model"/>
                                        <TableColumn fx:id="priceMouseColumn" text="Price(PHP)"/>
                                        <TableColumn fx:id="imageMouseColumn" text="Image"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="stockMouse" promptText="Stock" prefWidth="60"/>
                                    <TextField fx:id="brandMouse" promptText="Brand" prefWidth="100"/>
                                    <TextField fx:id="modelMouse" promptText="Model" prefWidth="150"/>
                                    <TextField fx:id="priceMouse" promptText="Price" prefWidth="80"/>
                                    <TextField fx:id="imageMouse" promptText="Image" prefWidth="150"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="addMouse" text="Add" onAction="#addProduct"/>
                                    <Button fx:id="editMouse" text="Edit" onAction="#editProduct"/>
                                    <Button fx:id="deleteMouse" text="Delete" onAction="#deleteProduct"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- Storage Tab -->
                    <Tab text="Storage">
                        <content>
                            <VBox spacing="10">
                                <TableView fx:id="tableStorage" prefHeight="200">
                                    <columns>
                                        <TableColumn fx:id="stockStorageColumn" text="Stock"/>
                                        <TableColumn fx:id="brandStorageColumn" text="Brand"/>
                                        <TableColumn fx:id="modelStorageColumn" text="Model"/>
                                        <TableColumn fx:id="priceStorageColumn" text="Price(PHP)"/>
                                        <TableColumn fx:id="imageStorageColumn" text="Image"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="stockStorage" promptText="Stock" prefWidth="60"/>
                                    <TextField fx:id="brandStorage" promptText="Brand" prefWidth="100"/>
                                    <TextField fx:id="modelStorage" promptText="Model" prefWidth="150"/>
                                    <TextField fx:id="priceStorage" promptText="Price" prefWidth="80"/>
                                    <TextField fx:id="imageStorage" promptText="Image" prefWidth="150"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="addStorage" text="Add" onAction="#addProduct"/>
                                    <Button fx:id="editStorage" text="Edit" onAction="#editProduct"/>
                                    <Button fx:id="deleteStorage" text="Delete" onAction="#deleteProduct"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- Memory Tab -->
                    <Tab text="Memory">
                        <content>
                            <VBox spacing="10">
                                <TableView fx:id="tableMemory" prefHeight="200">
                                    <columns>
                                        <TableColumn fx:id="stockMemoryColumn" text="Stock"/>
                                        <TableColumn fx:id="brandMemoryColumn" text="Brand"/>
                                        <TableColumn fx:id="modelMemoryColumn" text="Model"/>
                                        <TableColumn fx:id="priceMemoryColumn" text="Price(PHP)"/>
                                        <TableColumn fx:id="imageMemoryColumn" text="Image"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="stockMemory" promptText="Stock" prefWidth="60"/>
                                    <TextField fx:id="brandMemory" promptText="Brand" prefWidth="100"/>
                                    <TextField fx:id="modelMemory" promptText="Model" prefWidth="150"/>
                                    <TextField fx:id="priceMemory" promptText="Price" prefWidth="80"/>
                                    <TextField fx:id="imageMemory" promptText="Image" prefWidth="150"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="addMemory" text="Add" onAction="#addProduct"/>
                                    <Button fx:id="editMemory" text="Edit" onAction="#editProduct"/>
                                    <Button fx:id="deleteMemory" text="Delete" onAction="#deleteProduct"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- Monitor Tab -->
                    <Tab text="Monitor">
                        <content>
                            <VBox spacing="10">
                                <TableView fx:id="tableMonitor" prefHeight="200">
                                    <columns>
                                        <TableColumn fx:id="stockMonitorColumn" text="Stock"/>
                                        <TableColumn fx:id="brandMonitorColumn" text="Brand"/>
                                        <TableColumn fx:id="modelMonitorColumn" text="Model"/>
                                        <TableColumn fx:id="priceMonitorColumn" text="Price(PHP)"/>
                                        <TableColumn fx:id="imageMonitorColumn" text="Image"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="stockMonitor" promptText="Stock" prefWidth="60"/>
                                    <TextField fx:id="brandMonitor" promptText="Brand" prefWidth="100"/>
                                    <TextField fx:id="modelMonitor" promptText="Model" prefWidth="150"/>
                                    <TextField fx:id="priceMonitor" promptText="Price" prefWidth="80"/>
                                    <TextField fx:id="imageMonitor" promptText="Image" prefWidth="150"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="addMonitor" text="Add" onAction="#addProduct"/>
                                    <Button fx:id="editMonitor" text="Edit" onAction="#editProduct"/>
                                    <Button fx:id="deleteMonitor" text="Delete" onAction="#deleteProduct"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>

                </TabPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
