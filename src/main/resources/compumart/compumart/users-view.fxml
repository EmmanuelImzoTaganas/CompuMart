<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="root" stylesheets="@cssfiles/main.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="compumart.compumart.controller.usercontroller">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-bar">
                <padding>
                    <Insets top="10.0" right="30.0" bottom="10.0" left="30.0"/>
                </padding>
                <children>
                    <Label styleClass="store-title" text="COMPUMART ADMIN"/>
                    <HBox HBox.hgrow="ALWAYS"/> <Button mnemonicParsing="false" styleClass="nav-button" text="Dashboard"/>
                    <Button mnemonicParsing="false" styleClass="nav-button-selected" text="Users"/>
                    <Button mnemonicParsing="false" styleClass="nav-button" text="Orders"/>
                    <Button fx:id="logoutButton" mnemonicParsing="false" styleClass="nav-button" text="Logout"/>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="filter-bar">
                <padding>
                    <Insets top="15.0" right="30.0" bottom="15.0" left="30.0"/>
                </padding>
                <children>
                    <Label styleClass="filter-bar-title" text="User Management"/>
                    <Region HBox.hgrow="ALWAYS"/> <TextField fx:id="searchUserField" promptText="Search users..." prefWidth="250.0"/>
                    <Button fx:id="backButton" text="Back to Dashboard" onAction="#backAdmin"
                            styleClass="cart-button" mnemonicParsing="false"/>
                </children>
            </HBox>

        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f4f4f4;">
            <VBox alignment="TOP_CENTER" spacing="20.0">
                <padding>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                </padding>

                <VBox style="-fx-background-color: #fcf6e8; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <Label text="All Registered Users" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 15 0;"/>
                        <TableView fx:id="usersTable" prefHeight="500.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="180"/>
                                <TableColumn fx:id="emailColumn" text="Email" prefWidth="250"/>
                                <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="150"/>
                                <TableColumn fx:id="actionColumn" text="Actions" prefWidth="180" sortable="false"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>