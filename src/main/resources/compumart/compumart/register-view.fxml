<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21.0.6"
           fx:controller="compumart.compumart.controller.RegisterController"
           xmlns:fx="http://javafx.com/fxml/1">
    <VBox alignment="CENTER" prefHeight="400.0" prefWidth="500.0" spacing="20" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 15;">
        <Label prefHeight="35.0" prefWidth="287.0" style="-fx-font-size: 24; -fx-font-weight: bold;" text="🖥️ CompuMart Register" />

        <GridPane alignment="CENTER" vgap="15" hgap="10">
            <!-- First Name -->
            <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="fNameField" promptText="Enter your first name" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <!-- Last Name -->
            <Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="lNameField" promptText="Enter your last name" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <!-- Email -->
            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="emailField" promptText="Enter your email" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <!-- Password -->
            <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <!-- Confirm Password -->
            <Label text="Confirm Password:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <!-- Phone -->
            <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <TextField fx:id="phoneField" promptText="Enter your phone number" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <!-- Address -->
            <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
            <TextArea fx:id="addressField" promptText="Enter your address" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="10" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="7">
                <Button fx:id="registerButton" onAction="#onRegisterUser" text="Register" defaultButton="true" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="clearButton" onAction="#onCancel" text="Cancel" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
            </HBox>

            <columnConstraints>
                <ColumnConstraints maxWidth="150.0" minWidth="120.0" prefWidth="130.0" />
                <ColumnConstraints maxWidth="300.0" minWidth="250.0" prefWidth="280.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints minHeight="40.0" prefHeight="40.0" />
            </rowConstraints>
        </GridPane>
    </VBox>
</StackPane>