<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="root" stylesheets="@cssfiles/main.css, @cssfiles/admin.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="compumart.compumart.controller.admincontroller">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-bar">
                <padding>
                    <Insets top="10.0" right="30.0" bottom="10.0" left="30.0"/>
                </padding>
                <children>
                    <Label styleClass="store-title" text="COMPUMART ADMIN"/>
                    <HBox HBox.hgrow="ALWAYS"/> <Button mnemonicParsing="false" styleClass="nav-button-selected" text="Dashboard"/>
                    <Button onAction="#onProducts" mnemonicParsing="false" styleClass="nav-button" text="Manage Products"/>
                    <Button onAction="#onOrder" mnemonicParsing="false" styleClass="nav-button" text="View Orders"/>
                    <Button onAction="#onUser" mnemonicParsing="false" styleClass="nav-button" text="Manage Users"/>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="filter-bar">
                <padding>
                    <Insets top="15.0" right="30.0" bottom="15.0" left="30.0"/>
                </padding>
                <children>
                    <Label styleClass="filter-bar-title" text="Admin Dashboard"/>
                    <Region HBox.hgrow="ALWAYS"/> <Button onAction="#onLogOut" text="Log Out" styleClass="cart-button" mnemonicParsing="false"/>
                </children>
            </HBox>

        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f4f4f4;">
            <content>
                <HBox alignment="TOP_CENTER">
                    <padding>
                        <Insets top="50.0" right="50.0" bottom="50.0" left="50.0"/>
                    </padding>
                    <children>
                        <VBox alignment="CENTER" spacing="15.0"
                              style="-fx-background-color: #fcf6e8; -fx-background-radius: 12; -fx-padding: 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              maxWidth="600">
                            <children>
                                <Label text="Welcome, Admin!" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                                <Label text="Please use the navigation bar above to manage products, users, and orders."
                                       style="-fx-font-size: 16px; -fx-text-fill: #555; -fx-wrap-text: true; -fx-text-alignment: center;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>