<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.TilePane?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="compumart.compumart.controller.AdminController">
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox alignment="CENTER" spacing="20">
                <Label text="CompuMart - Admin Panel" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button text="Dashboard" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 16;" />
                    <Button text="Manage Products" onAction="#manageProducts" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Manage Orders" onAction="#manageOrders" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Reports" onAction="#viewReports" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                </HBox>
                <Button text="Logout" onAction="#logout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 16;" HBox.hgrow="ALWAYS" HBox.alignment="CENTER_RIGHT" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 40;" spacing="30" alignment="CENTER">
            <Label fx:id="welcomeLabel" text="Welcome, Admin!" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <Label fx:id="statsLabel" text="Admin Dashboard" style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d;" />

            <TilePane hgap="20" vgap="20" prefColumns="3">
                <!-- Admin Cards -->
                <VBox style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" spacing="10" prefWidth="250">
                    <Label text="Products" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label text="Manage product catalog" style="-fx-text-fill: #7f8c8d;" />
                    <Button text="Manage" onAction="#manageProducts" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10 20;" />
                </VBox>

                <VBox style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" spacing="10" prefWidth="250">
                    <Label text="Orders" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label text="View and manage orders" style="-fx-text-fill: #7f8c8d;" />
                    <Button text="Manage" onAction="#manageOrders" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10 20;" />
                </VBox>

                <VBox style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" spacing="10" prefWidth="250">
                    <Label text="Reports" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label text="View sales reports" style="-fx-text-fill: #7f8c8d;" />
                    <Button text="View" onAction="#viewReports" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10 20;" />
                </VBox>
            </TilePane>
        </VBox>
    </center>
</BorderPane>