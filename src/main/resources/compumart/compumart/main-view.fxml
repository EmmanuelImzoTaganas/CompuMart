<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="root" stylesheets="@cssfiles/main.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="compumart.compumart.controller.maincontroller">

    <top>
        <VBox style="-fx-background-color: #f8f8f8; -fx-padding: 0 0 1px 0;">
            <HBox alignment="CENTER" spacing="40.0" style="-fx-background-color: #2c3e50; -fx-padding: 15 30;">
                <Label style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" text="COMPUMART">
                    <graphic>
                        <Label text="💻" style="-fx-font-size: 28px;"/>
                    </graphic>
                </Label>
                <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="20.0">
                    <Button mnemonicParsing="false" text="Store" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 18; -fx-background-radius: 5;"/>
                    <Button fx:id="accountButton" mnemonicParsing="false" text="My Account" onAction="#handleGoToAccount"
                            style="-fx-background-color: transparent; -fx-border-color: #ecf0f1; -fx-border-width: 1; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 8 18; -fx-background-radius: 5;"/>
                </HBox>
            </HBox>

            <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15 30;">
                <TextField fx:id="searchBar" promptText="Search for products..." prefWidth="400.0" prefHeight="35"
                           style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #ccc; -fx-padding: 0 15; -fx-font-size: 14px;"/>
                <Label text="Category:" style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
                <ChoiceBox fx:id="categoryChoiceBox" prefWidth="180.0" prefHeight="35"
                           style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #ccc; -fx-padding: 0 10; -fx-font-size: 14px;"/>
                <StackPane>
                    <Button fx:id="cartButton" mnemonicParsing="false" onAction="#handleGoToCart"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20; -fx-background-radius: 20;">
                        <graphic>
                            <Label text="🛒" style="-fx-font-size: 18px; -fx-text-fill: white;"/>
                        </graphic>
                        <text>Cart (<Label fx:id="cartItemCount" text="0" style="-fx-font-size: 14px; -fx-text-fill: white;"/>)</text>
                    </Button>
                </StackPane>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #ecf0f1;">
            <content>
                <TilePane fx:id="catalogTilePane" hgap="25.0" vgap="25.0" alignment="TOP_LEFT">
                    <padding>
                        <Insets top="25.0" right="35.0" bottom="25.0" left="35.0"/>
                    </padding>
                </TilePane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>