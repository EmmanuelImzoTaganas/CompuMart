<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2);">

    <VBox alignment="CENTER" spacing="25" style="-fx-padding: 40; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 10);">

        <!-- Header -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="🖥️ CompuMart">
                <font>
                    <Font name="System Bold" size="36.0" />
                </font>
            </Label>
            <Label text="Create Your Account" style="-fx-text-fill: #7f8c8d; -fx-font-size: 16;"/>
        </VBox>

        <!-- Registration Form -->
        <GridPane vgap="15" hgap="15" alignment="CENTER">
            <padding>
                <Insets top="20" bottom="20" left="30" right="30"/>
            </padding>

            <!-- First Name -->
            <Label text="👤 First Name" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;"/>
            <TextField promptText="Enter your first name"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-pref-width: 280; -fx-pref-height: 40; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7; -fx-font-size: 14;"/>

            <!-- Last Name -->
            <Label text="👤 Last Name" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;"/>
            <TextField promptText="Enter your last name"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-pref-width: 280; -fx-pref-height: 40; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7; -fx-font-size: 14;"/>

            <!-- Email -->
            <Label text="📧 Email" GridPane.rowIndex="2" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;"/>
            <TextField promptText="Enter your email"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-pref-width: 280; -fx-pref-height: 40; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7; -fx-font-size: 14;"/>

            <!-- Password -->
            <Label text="🔒 Password" GridPane.rowIndex="3" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;"/>
            <PasswordField promptText="Create a password"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"
                           style="-fx-pref-width: 280; -fx-pref-height: 40; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7; -fx-font-size: 14;"/>

            <!-- Confirm Password -->
            <Label text="🔒 Confirm Password" GridPane.rowIndex="4" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;"/>
            <PasswordField promptText="Confirm your password"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"
                           style="-fx-pref-width: 280; -fx-pref-height: 40; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7; -fx-font-size: 14;"/>

            <!-- Register Button -->
            <Button text="🚀 Create Account"
                    GridPane.rowIndex="5" GridPane.columnIndex="1"
                    style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-pref-width: 280; -fx-pref-height: 45; -fx-background-radius: 8; -fx-cursor: hand;"
                    GridPane.halignment="RIGHT"/>
        </GridPane>

        <!-- Login Link -->
        <VBox alignment="CENTER" spacing="15">
            <Label text="Already have an account?" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14;"/>
            <Hyperlink text="⬅️ Back to Login" fx:id="loginLink"
                       style="-fx-text-fill: #667eea; -fx-font-weight: bold; -fx-font-size: 14; -fx-border-color: transparent; -fx-cursor: hand;"/>
        </VBox>

        <!-- Info Box -->
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #e9ecef; -fx-border-radius: 10;">
            <Label text="💡 Account Benefits" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;"/>
            <Label text="✓ Save your order history" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12;"/>
            <Label text="✓ Faster checkout process" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12;"/>
            <Label text="✓ Track your orders" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12;"/>
        </VBox>

    </VBox>
</StackPane>