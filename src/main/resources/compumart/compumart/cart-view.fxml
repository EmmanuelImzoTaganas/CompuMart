<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="root" stylesheets="@cssfiles/main.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="compumart.compumart.controller.cartcontroller">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-bar">
                <padding>
                    <Insets top="10.0" right="30.0" bottom="10.0" left="30.0"/>
                </padding>
                <children>
                    <Label styleClass="store-title" text="COMPUMART"/>
                    <HBox HBox.hgrow="ALWAYS"/> <Button fx:id="storeButton" mnemonicParsing="false" styleClass="nav-button-selected" text="Store"/>
                    <Button fx:id="accountButton" mnemonicParsing="false" styleClass="nav-button" text="My Account"/>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="filter-bar">
                <padding>
                    <Insets top="15.0" right="30.0" bottom="15.0" left="30.0"/>
                </padding>
                <children>
                    <Label styleClass="filter-bar-title" text="Your Shopping Cart"/>
                    <Region HBox.hgrow="ALWAYS"/> <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleGoBack"
                                                          styleClass="cart-button" text="Back to Store"/>
                </children>
            </HBox>

        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f4f4f4;">
            <content>
                <HBox spacing="30.0">
                    <padding>
                        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                    </padding>
                    <children>

                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #fcf6e8; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                            <children>
                                <Label text="Items in your Cart"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 15 0;"/>
                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane"
                                            VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox fx:id="cartItemsContainer" spacing="10.0">
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                                            </padding>
                                            <Label fx:id="emptyCartLabel" text="Your cart is empty."/>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <VBox prefWidth="280.0" spacing="15.0"
                              style="-fx-background-color: #fcf6e8; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                            <children>
                                <Label styleClass="summary-title" text="Order Summary"/>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Subtotal:"/>
                                        <HBox HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="subtotalLabel" styleClass="summary-value" text="$0.00"/>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Tax (8%):"/> <HBox HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="taxLabel" styleClass="summary-value" text="$0.00"/>
                                    </children>
                                </HBox>
                                <VBox styleClass="separator" prefHeight="2.0"/>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="summary-total-label" text="Total:"/> <HBox HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="totalLabel" styleClass="summary-total-value" text="$0.00"/>
                                    </children>
                                </HBox>
                                <Button fx:id="checkoutButton" maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#handleCheckout" styleClass="checkout-button"
                                        text="Proceed to Checkout"/> </children>
                        </VBox>
                    </children>
                </HBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>