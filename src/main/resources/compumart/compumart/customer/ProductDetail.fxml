<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SpinnerValueFactory?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox alignment="CENTER" spacing="20">
                <Label text="CompuMart" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button text="Home" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Products" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Cart" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="30" style="-fx-padding: 30;" alignment="TOP_CENTER">
            <!-- Product Image -->
            <VBox spacing="10" alignment="CENTER">
                <ImageView fitWidth="400" fitHeight="300" preserveRatio="true">
                    <Image url="@../../../resources/images/laptop-detail-placeholder.png" />
                </ImageView>
            </VBox>

            <!-- Product Details -->
            <VBox spacing="15" prefWidth="500">
                <Label text="Gaming Laptop Pro" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Label text="Brand: ASUS ROG" style="-fx-text-fill: #7f8c8d; -fx-font-size: 16px;" />
                <Label text="$1,299.99" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                <Label text="In Stock: 15 items" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" />

                <VBox spacing="5">
                    <Label text="Description:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                    <TextArea text="Powerful gaming laptop featuring NVIDIA RTX 4070, Intel Core i7 processor, 16GB RAM, 1TB SSD, and 15.6-inch 144Hz display. Perfect for gaming and professional work."
                              style="-fx-border-color: #ddd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;"
                              wrapText="true" editable="false" prefRowCount="4" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Specifications:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                    <Label text="• Processor: Intel Core i7-13700H" style="-fx-text-fill: #7f8c8d;" />
                    <Label text="• Graphics: NVIDIA RTX 4070 8GB" style="-fx-text-fill: #7f8c8d;" />
                    <Label text="• RAM: 16GB DDR5" style="-fx-text-fill: #7f8c8d;" />
                    <Label text="• Storage: 1TB NVMe SSD" style="-fx-text-fill: #7f8c8d;" />
                    <Label text="• Display: 15.6' FHD 144Hz" style="-fx-text-fill: #7f8c8d;" />
                </VBox>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Quantity:" style="-fx-font-weight: bold;" />
                        <Spinner valueFactory="@{new SpinnerValueFactory.IntegerSpinnerValueFactory(1, 10, 1)}" prefWidth="80" />
                    </VBox>
                    <Button text="Add to Cart" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 12 24; -fx-font-weight: bold; -fx-font-size: 14px;" />
                    <Button text="Buy Now" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 12 24; -fx-font-weight: bold; -fx-font-size: 14px;" />
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>