<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="compumart.compumart.controller.CartController">
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox alignment="CENTER" spacing="20">
                <Label text="CompuMart" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button text="Home" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Products" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Cart" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 16;" />
                    <Button text="Orders" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 20;" spacing="20">
            <Label text="Shopping Cart" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

            <TableView fx:id="cartTable" prefHeight="400" style="-fx-border-color: #ddd; -fx-border-radius: 4;">
                <columns>
                    <TableColumn text="Product" prefWidth="250">
                        <cellValueFactory>
                            <PropertyValueFactory property="product.name" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Price" prefWidth="100">
                        <cellValueFactory>
                            <PropertyValueFactory property="product.price" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Quantity" prefWidth="100">
                        <cellValueFactory>
                            <PropertyValueFactory property="quantity" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Total" prefWidth="100">
                        <cellValueFactory>
                            <PropertyValueFactory property="totalPrice" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Actions" prefWidth="150">
                        <cellValueFactory>
                            <PropertyValueFactory property="actions" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>

            <HBox spacing="20" alignment="CENTER_RIGHT">
                <Label fx:id="totalLabel" text="Total: $0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <HBox spacing="10">
                    <Button fx:id="continueShoppingButton" text="Continue Shopping" onAction="#handleContinueShopping" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10 20;" />
                    <Button fx:id="checkoutButton" text="Proceed to Checkout" onAction="#handleCheckout" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10 20; -fx-font-weight: bold;" />
                </HBox>
            </HBox>

            <!-- Sample cart items (placeholder) -->
            <VBox fx:id="cartItemsContainer" spacing="10" style="-fx-padding: 10; -fx-border-color: #eee; -fx-border-radius: 4; -fx-background-color: #f8f9fa;">
                <Label text="Sample Cart Items (Placeholder)" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Gaming Laptop Pro" style="-fx-font-weight: bold;" />
                    <Label text="x 1" />
                    <Label text="$1,299.99" style="-fx-text-fill: #27ae60;" />
                    <Button text="Remove" onAction="#removeFromCart" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5 10;" />
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Mechanical Keyboard" style="-fx-font-weight: bold;" />
                    <Label text="x 2" />
                    <Label text="$179.98" style="-fx-text-fill: #27ae60;" />
                    <Button text="Remove" onAction="#removeFromCart" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5 10;" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>