<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="compumart.compumart.controller.ProductController">
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox alignment="CENTER" spacing="20">
                <Label text="CompuMart" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button text="Home" onAction="#goToHome" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Products" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 16;" />
                    <Button text="Cart" fx:id="cartButton" onAction="#goToCart" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Orders" onAction="#goToOrders" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                </HBox>

                <!-- User Menu -->
                <HBox fx:id="userMenu" spacing="10" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <Label fx:id="welcomeLabel" text="Welcome, User!" style="-fx-text-fill: #ecf0f1;" />
                    <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5 10;" />
                </HBox>

                <Button fx:id="loginButton" text="Login" onAction="#handleLogin" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5 10;" />
            </HBox>

            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <TextField fx:id="searchField" promptText="Search products..." prefWidth="300" style="-fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" />
                <ComboBox fx:id="categoryFilter" promptText="All Categories" prefWidth="150" />
                <Button text="Search" onAction="#handleSearch" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 16;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 20;" spacing="15">
            <Label text="Computer Products" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

            <TilePane hgap="20" vgap="20" prefColumns="3" style="-fx-padding: 10;">
                <!-- Product Card 1 -->
                <VBox style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" spacing="10" prefWidth="250">
                    <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                        <Image url="@../../../resources/images/laptop-placeholder.png" />
                    </ImageView>
                    <Label text="Gaming Laptop Pro" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label text="Powerful gaming laptop with RTX 4070" style="-fx-text-fill: #7f8c8d; -fx-wrap-text: true;" />
                    <Label text="$1,299.99" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                    <HBox spacing="10">
                        <Button text="View Details" onAction="#viewProductDetails" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 12;" />
                        <Button text="Add to Cart" onAction="#handleAddToCart" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 12;" />
                    </HBox>
                </VBox>

                <!-- Product Card 2 -->
                <VBox style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" spacing="10" prefWidth="250">
                    <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                        <Image url="@../../../resources/images/desktop-placeholder.png" />
                    </ImageView>
                    <Label text="Gaming Desktop" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label text="High-performance desktop computer" style="-fx-text-fill: #7f8c8d; -fx-wrap-text: true;" />
                    <Label text="$1,599.99" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                    <HBox spacing="10">
                        <Button text="View Details" onAction="#viewProductDetails" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 12;" />
                        <Button text="Add to Cart" onAction="#handleAddToCart" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 12;" />
                    </HBox>
                </VBox>

                <!-- Product Card 3 -->
                <VBox style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" spacing="10" prefWidth="250">
                    <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                        <Image url="@../../../resources/images/keyboard-placeholder.png" />
                    </ImageView>
                    <Label text="Mechanical Keyboard" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label text="RGB mechanical gaming keyboard" style="-fx-text-fill: #7f8c8d; -fx-wrap-text: true;" />
                    <Label text="$89.99" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                    <HBox spacing="10">
                        <Button text="View Details" onAction="#viewProductDetails" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 12;" />
                        <Button text="Add to Cart" onAction="#handleAddToCart" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 12;" />
                    </HBox>
                </VBox>
            </TilePane>
        </VBox>
    </center>
</BorderPane>