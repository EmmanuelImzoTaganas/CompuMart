<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="compumart.compumart.controller.CartController">
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox alignment="CENTER" spacing="20">
                <Label text="CompuMart" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button text="Home" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Products" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Cart" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: transparent;" />
                    <Button text="Checkout" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8 16;" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="30" style="-fx-padding: 30;" alignment="TOP_CENTER">
            <!-- Shipping Information -->
            <VBox spacing="20" prefWidth="500">
                <Label text="Shipping Information" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                <VBox style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" spacing="15">
                    <GridPane hgap="10" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <Label text="First Name" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                        <TextField promptText="First name" GridPane.columnIndex="0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" />

                        <Label text="Last Name" GridPane.columnIndex="1" style="-fx-font-weight: bold;" />
                        <TextField promptText="Last name" GridPane.columnIndex="1" style="-fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" />

                        <Label text="Email" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
                        <TextField promptText="Email address" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" />

                        <Label text="Phone" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
                        <TextField promptText="Phone number" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" />

                        <Label text="Address" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2" style="-fx-font-weight: bold;" />
                        <TextArea promptText="Full shipping address" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2"
                                  style="-fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;"
                                  prefRowCount="3" />
                    </GridPane>
                </VBox>

                <Label text="Payment Method" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                <VBox style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" spacing="15">
                    <ComboBox promptText="Select Payment Method" prefWidth="300">
                        <items>
                            <String fx:value="Credit Card" />
                            <String fx:value="Debit Card" />
                            <String fx:value="PayPal" />
                            <String fx:value="Bank Transfer" />
                        </items>
                    </ComboBox>

                    <TextField promptText="Card Number" style="-fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" />

                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <TextField promptText="MM/YY" GridPane.columnIndex="0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" />
                        <TextField promptText="CVV" GridPane.columnIndex="1" style="-fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;" />
                    </GridPane>
                </VBox>
            </VBox>

            <!-- Order Summary -->
            <VBox spacing="15" prefWidth="300">
                <Label text="Order Summary" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                <VBox style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" spacing="10">
                    <HBox spacing="10">
                        <Label text="Gaming Laptop Pro" style="-fx-font-weight: bold;" />
                        <Label text="x 1" />
                        <Label text="$1,299.99" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" />
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Mechanical Keyboard" style="-fx-font-weight: bold;" />
                        <Label text="x 2" />
                        <Label text="$179.98" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" />
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Shipping" />
                        <Label text="$0.00" style="-fx-text-fill: #27ae60;" />
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Tax" />
                        <Label text="$88.50" style="-fx-text-fill: #27ae60;" />
                    </HBox>

                    <HBox spacing="10" style="-fx-border-color: #ddd; -fx-border-width: 1 0 0 0; -fx-padding: 10 0 0 0;">
                        <Label text="Total" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                        <Label text="$1,568.47" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 16px;" />
                    </HBox>

                    <Button text="Place Order" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 12; -fx-font-weight: bold; -fx-font-size: 16px;" />
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>